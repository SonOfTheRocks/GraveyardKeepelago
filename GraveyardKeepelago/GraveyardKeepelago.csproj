<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <AssemblyName>GraveyardKeepelago</AssemblyName>
        <Description>Archipelago Randomizer for Graveyard Keeper</Description>
        <Version>0.0.1</Version>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <BaseOutputPath>bin\</BaseOutputPath>
        <RootNamespace>GraveyardKeepelago</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.0" />
        <PackageReference Include="Archipelago.MultiClient.Net.Analyzers" Version="2.0.3">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all" />
        <PackageReference Include="BepInEx.Core" Version="5.4.21" />
        <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
        <PackageReference Include="ILRepack" Version="2.0.44" PrivateAssets="all" GeneratePathProperty="true" ExcludeAssets="all" />
        <PackageReference Include="Harmonize" Version="1.0.6" />
        <PackageReference Include="KaitoKid.ArchipelagoUtilities.Net" Version="3.1.11" />
        <PackageReference Include="KaitoKid.Utilities.Interfaces" Version="3.1.11">
            <PrivateAssets>none</PrivateAssets>
        </PackageReference>
        <PackageReference Include="UnityEngine.Modules" Version="2020.3.17" IncludeAssets="compile" />
    </ItemGroup>
    
    <PropertyGroup Condition="'$(Configuration)' == 'Dump'">
        <DefineConstants>$(DefineConstants);DUMP_MODE</DefineConstants>
    </PropertyGroup>

    <Import Project="..\GamePath.props.user"
            Condition="'$(GamePath)' == '' and Exists('..\GamePath.props.user')" />

    <PropertyGroup Label="UserMacros">
        <_ManagedGameDirectory>Graveyard Keeper_Data\Managed</_ManagedGameDirectory>
        <_SteamGamePath>$(MSBuildProgramFiles32)\Steam\steamapps\common\Graveyard Keeper</_SteamGamePath>
        <_GogGamePath>$(MSBuildProgramFiles32)\GOG Galaxy\Games\Graveyard Keeper</_GogGamePath>
        <GamePath Condition="'$(GamePath)' == '' and Exists('$(_SteamGamePath)\$(_ManagedGameDirectory)\Assembly-CSharp.dll') and Exists('$(_SteamGamePath)\$(_ManagedGameDirectory)\Assembly-CSharp-firstpass.dll')">$(_SteamGamePath)</GamePath>
        <GamePath Condition="'$(GamePath)' == '' and Exists('$(_GogGamePath)\$(_ManagedGameDirectory)\Assembly-CSharp.dll') and Exists('$(_GogGamePath)\$(_ManagedGameDirectory)\Assembly-CSharp-firstpass.dll')">$(_GogGamePath)</GamePath>
        <BepInExLauncher>BepInEx.NET.Framework.Launcher.exe</BepInExLauncher>
    </PropertyGroup>

    <ItemGroup>
        <Reference Include="Assembly-CSharp">
            <HintPath>$(GamePath)\$(_ManagedGameDirectory)\Assembly-CSharp.dll</HintPath>
        </Reference>
        <Reference Include="Assembly-CSharp-firstpass">
            <HintPath>$(GamePath)\$(_ManagedGameDirectory)\Assembly-CSharp-firstpass.dll</HintPath>
        </Reference>
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="Dumps\**\*.cs" />
    </ItemGroup>

    <ItemGroup>
        <Folder Include="DebugPatches\" />
        <Folder Include="Properties\" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Resources\archipelago_32x32.png" />
    </ItemGroup>

    <PropertyGroup>
        <_SharedDataDirectory>$(MSBuildProjectDirectory)\..\External\GraveyardKeeperData</_SharedDataDirectory>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="$(_SharedDataDirectory)\manifest.json;$(_SharedDataDirectory)\item_grants.json;$(_SharedDataDirectory)\locations.json;$(_SharedDataDirectory)\quest_reward_triggers.json;$(_SharedDataDirectory)\technologies.json"
                          LogicalName="GraveyardKeepelago.Data/%(Filename)%(Extension)" />
        <EmbeddedResource Include="$(_SharedDataDirectory)\items\**\*.json"
                          LogicalName="GraveyardKeepelago.Data/items/%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>

    <Target Name="ValidateSharedData" BeforeTargets="PrepareResources">
        <Error Condition="!Exists('$(_SharedDataDirectory)\manifest.json')"
               Text="Graveyard Keeper shared data is missing. Run git submodule update --init." />
    </Target>

    <Target Name="ValidateGamePath" BeforeTargets="ResolveAssemblyReferences" Condition="'$(DesignTimeBuild)' != 'true'">
        <Error Condition="'$(GamePath)' == ''"
               Text="Graveyard Keeper was not found at '$(_SteamGamePath)' or '$(_GogGamePath)'. Set GamePath.props.user or pass -p:GamePath=&quot;path to Graveyard Keeper&quot;." />
        <Error Condition="!Exists('$(GamePath)\$(_ManagedGameDirectory)\Assembly-CSharp.dll') or !Exists('$(GamePath)\$(_ManagedGameDirectory)\Assembly-CSharp-firstpass.dll')"
               Text="GamePath '$(GamePath)' must contain Assembly-CSharp.dll and Assembly-CSharp-firstpass.dll in '$(_ManagedGameDirectory)'." />
    </Target>

    <Target Name="WritePackagingInputs" AfterTargets="Build" Condition="'$(PackageClient)' == 'true'">
        <WriteLinesToFile File="$(OutputPath)packaging-reference-directories.txt" Lines="@(ReferencePath->'%(RootDir)%(Directory)')" Overwrite="true" />
        <WriteLinesToFile File="$(OutputPath)ilrepack-path.txt" Lines="$(PkgILRepack)/tools/ILRepack.exe" Overwrite="true" />
    </Target>

    <Target Name="CopyModToDebugFolder" AfterTargets="Build" Condition="'$(PluginsPath)' != '' and '$(PackageClient)' != 'true'">
        <Message Text="Copying the mod to the plugins folder $(OutputPath)$(AssemblyName).dll -> $(PluginsPath)" Importance="High" />
        <Copy SourceFiles="$(OutputPath)$(AssemblyName).dll" DestinationFolder="$(PluginsPath)" ContinueOnError="false" />
        <Copy SourceFiles="$(OutputPath)$(AssemblyName).pdb" DestinationFolder="$(PluginsPath)" ContinueOnError="false" />
        <Copy SourceFiles="$(OutputPath)Archipelago.MultiClient.Net.dll" DestinationFolder="$(PluginsPath)" ContinueOnError="false" />
        <Copy SourceFiles="$(OutputPath)KaitoKid.ArchipelagoUtilities.Net.dll" DestinationFolder="$(PluginsPath)" ContinueOnError="false" />
        <Copy SourceFiles="$(OutputPath)KaitoKid.Utilities.Interfaces.dll" DestinationFolder="$(PluginsPath)" ContinueOnError="false" />
        <Message Text="Copied mod files" Importance="High" />
    </Target>

</Project>
